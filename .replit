entrypoint = "main.py"
modules = ["python-3.10:v18-20230807-322e88b"]

[nix]
channel = "stable-23_05"
packages = ["libxcrypt"]

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["python3", "main.py"]
deploymentTarget = "cloudrun"

[workflows]
runButton = "Run code"

[[workflows.workflow]]
name = "Run code"
mode = "sequential"
author = 34556406

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run code"
